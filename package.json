{
  "name": "graphql-markdown-honkit-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone GraphQL-Markdown demo for HonKit",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "gqlmd graphql-to-doc",
    "summary": "node ./scripts/build-summary.mjs",
    "prepare": "npm run generate && npm run summary",
    "dev": "npm run prepare && honkit serve docs",
    "build": "npm run prepare && honkit build docs docs/_book",
    "clean": "rm -rf docs/graphql docs/SUMMARY.md docs/_nav _book docs/_book"
  },
  "dependencies": {
    "@graphql-markdown/cli": "^1.2.3",
    "@graphql-markdown/formatters": "^1.2.3",
    "@graphql-markdown/utils": "^1.14.3",
    "@graphql-tools/url-loader": "^10.0.9",
    "graphql": "^17.1.0"
  },
  "devDependencies": {
    "honkit": "^6.2.5",
    "honkit-plugin-toggle-chapters": "^0.0.1"
  }
}

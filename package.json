{
  "name": "graphql-markdown-honkit-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone GraphQL-Markdown demo for HonKit",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "gqlmd graphql-to-doc && node scripts/generate-copies.mjs",
    "summary": "node ./scripts/build-summary.mjs",
    "prepare": "npm run generate && npm run summary",
    "dev": "npm run prepare && npx honkit serve docs",
    "build": "npm run prepare && npx honkit build docs _book && node -e \"require('node:fs').cpSync('.markdown-copies','docs/_book',{recursive:true})\"",
    "clean": "rm -rf .markdown-copies docs/graphql docs/SUMMARY.md docs/_nav _book docs/_book",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@graphql-markdown/cli": "^1.3.0",
    "@graphql-markdown/formatters": "^1.3.0",
    "@graphql-markdown/printer-legacy": "^1.21.0",
    "@graphql-markdown/utils": "^1.14.3",
    "@graphql-tools/url-loader": "^10.0.9",
    "graphql": "^17.1.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.0",
    "@playwright/test": "^1.65.0",
    "honkit": "^7.0.0",
    "serve": "^14.2.7"
  }
}
